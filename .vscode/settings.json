{
  "dotrush.roslyn.projectOrSolutionFiles": [],
  "files.exclude": {
    "**/.git": true,
    "**/Library": true,
    "**/Temp": true,
    "**/obj": true,
    "**/Logs": true
  },
  "search.exclude": {
    "Library/**": true,
    "Temp/**": true,
    "Logs/**": true,
    "UserSettings/**": true,
    "Build/**": true,
    "Builds/**": true,
    "obj/**": true,
    "Docs/AgentRuns/**": true,
    "Docs/Archive/**": true
  },
  "files.watcherExclude": {
    "**/Library/**": true,
    "**/Temp/**": true,
    "**/Logs/**": true,
    "**/obj/**": true
  },
  "[csharp]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.defaultFormatter": "nromanov.dotrush"
  }
}
